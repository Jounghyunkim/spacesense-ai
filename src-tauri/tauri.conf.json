{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceSense AI",
  "version": "1.0.0",
  "identifier": "com.spacesense.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpaceSense AI",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
